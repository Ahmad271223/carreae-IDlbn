// Prisma schema — Phase 1 domains (identity, career, verification, audit).
// Source of truth for the domain model: docs/DATABASE_SCHEMA.md.
// Status enums mirror @careerid/shared — keep both in sync (tested in CI later
// via a generated comparison; do not add values here without updating shared).
//
// Conventions: UUIDv7 ids (never sequential public ids), snake_case tables,
// soft delete (deletedAt) only where DATABASE_SCHEMA.md marks it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum UserStatus {
  ACTIVE
  LOCKED
  DEACTIVATED
  ERASED
}

enum IdentityProvider {
  GOOGLE
  APPLE
}

enum AuthCredentialType {
  TOTP
  WEBAUTHN
}

enum ProfileVisibility {
  PRIVATE
}

enum OrganizationType {
  SCHOOL
  UNIVERSITY
  LANGUAGE_SCHOOL
  TRAINING_PROVIDER
  EMPLOYER
}

enum OrgVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum OrganizationRole {
  OWNER
  ADMIN
  ISSUER
  RECRUITER
  VIEWER
}

enum RelationshipType {
  STUDENT
  ALUMNUS
  EMPLOYEE
  MEMBER
}

enum RelationshipStatus {
  INVITED
  ACTIVE
  ENDED
  DECLINED
}

enum RelationshipInitiator {
  ORG
  USER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  VOLUNTEER
  FREELANCE
}

enum SkillCategory {
  TECHNICAL
  SOCIAL
  PROFESSIONAL
  SOFTWARE
}

enum LanguageLevel {
  NATIVE
  A1
  A2
  B1
  B2
  C1
  C2
}

enum LanguageFramework {
  CEFR
  OTHER
}

enum LanguageSource {
  SELF_DECLARED
  CERTIFIED
}

enum VerificationStatus {
  NONE
  PENDING
  VERIFIED
  DECLINED
  EXPIRED
  REVOKED
}

enum VerificationSubjectType {
  EDUCATION
  EXPERIENCE
  LANGUAGE
}

enum ActionTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  MFA_CHALLENGE
}

enum OauthPurpose {
  LOGIN
  LINK
}

enum CredentialType {
  SCHOOL_LEAVING
  DEGREE
  TRANSCRIPT
  ENROLLMENT
  LANGUAGE
  COURSE
  CERTIFICATE
  EMPLOYMENT
}

enum CredentialStatus {
  OFFERED
  ACTIVE
  DECLINED_BY_SUBJECT
  EXPIRED
  REVOKED
  SUPERSEDED
}

enum RenderSourceType {
  CV
  COVER_LETTER
}

enum RenderJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum PlatformRole {
  USER
  ADMIN
}

enum ApplicationType {
  JOB
  UNIVERSITY
  GENERAL
}

enum ApplicationStatus {
  DRAFT
  SENT
}

enum ApplicationItemType {
  CV
  COVER_LETTER
  DOCUMENT
  CREDENTIAL
  REFERENCE
  PORTFOLIO
  SECTION
}

enum CoverLetterConvention {
  DE
  FR
  EN
  AR
}

enum CoverLetterBlockType {
  RECIPIENT
  SUBJECT
  SALUTATION
  OPENING
  BODY
  CLOSING
  SIGNATURE
}

enum BlockOrigin {
  USER
  AI_GENERATED
  AI_EDITED
}

enum CvItemSourceType {
  EXPERIENCE
  EDUCATION
  CREDENTIAL
  LANGUAGE
  SKILL
  CUSTOM
}

enum DocumentCategory {
  CV
  COVER_LETTER
  CERTIFICATE
  TRANSCRIPT
  REFERENCE
  PHOTO
  OTHER
}

enum DocumentOrigin {
  USER_UPLOADED
  PLATFORM_GENERATED
  INSTITUTION_ISSUED
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum AuditActorType {
  USER
  ORG_MEMBER
  ADMIN
  SYSTEM
}

// ---------- Identity & access ----------

model User {
  id              String     @id @default(uuid(7))
  /// Stored lower-cased; normalization enforced in the auth service.
  email           String     @unique
  emailVerifiedAt DateTime?  @map("email_verified_at")
  phone           String?    @unique
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  /// Null for SSO-only accounts.
  passwordHash    String?    @map("password_hash")
  status          UserStatus @default(ACTIVE)
  mfaEnabled      Boolean    @default(false) @map("mfa_enabled")
  /// Operator staff only — never self-assignable (RBAC.md).
  platformRole    PlatformRole @default(USER) @map("platform_role")
  locale          String     @default("en")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  identities           Identity[]
  authCredentials      AuthCredential[]
  sessions             Session[]
  profile              Profile?
  profileSensitive     ProfileSensitive?
  organizationMembers  OrganizationMember[]
  relationships        OrganizationRelationship[]
  educations           Education[]
  experiences          Experience[]
  skills               Skill[]
  languages            UserLanguage[]
  verificationRequests VerificationRequest[]      @relation("VerificationSubjectUser")
  notifications        Notification[]
  actionTokens         ActionToken[]
  documents            Document[]
  credentials          Credential[]               @relation("CredentialSubject")
  cvs                  Cv[]
  coverLetters         CoverLetter[]
  applications         Application[]
  sharePackages        SharePackage[]
  consents             Consent[]

  @@map("users")
}

model Identity {
  id              String           @id @default(uuid(7))
  userId          String           @map("user_id")
  provider        IdentityProvider
  providerSubject String           @map("provider_subject")
  createdAt       DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@map("identities")
}

model AuthCredential {
  id              String             @id @default(uuid(7))
  userId          String             @map("user_id")
  type            AuthCredentialType
  /// AES-256-GCM application-layer encrypted (SECURITY.md §4).
  secretEncrypted String             @map("secret_encrypted")
  label           String?
  /// TOTP enrollment counts only after the user proves possession with a code.
  confirmedAt     DateTime?          @map("confirmed_at")
  lastUsedAt      DateTime?          @map("last_used_at")
  revokedAt       DateTime?          @map("revoked_at")
  createdAt       DateTime           @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_credentials")
}

model Session {
  id         String    @id @default(uuid(7))
  userId     String    @map("user_id")
  /// Only the hash is stored; raw token lives in the httpOnly cookie.
  tokenHash  String    @unique @map("token_hash")
  deviceName String?   @map("device_name")
  ipCreated  String?   @map("ip_created")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Profile {
  userId      String            @id @map("user_id")
  /// normalized-name + CSPRNG suffix; not an authorization token (M6).
  slug        String            @unique
  firstName   String            @map("first_name")
  lastName    String            @map("last_name")
  /// FK to documents lands with the wallet in Phase 2.
  photoDocumentId String?       @map("photo_document_id")
  headline    String?
  summary     String?
  desiredRole String?           @map("desired_role")
  city        String?
  countryCode String?           @map("country_code")
  visibility  ProfileVisibility @default(PRIVATE)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

/// Separate table, separate access path (never in AI context or default projections).
model ProfileSensitive {
  userId                  String    @id @map("user_id")
  dateOfBirth             DateTime? @map("date_of_birth") @db.Date
  nationality             String?
  /// Application-layer encrypted.
  contactPhoneEncrypted   String?   @map("contact_phone_encrypted")
  contactAddressEncrypted String?   @map("contact_address_encrypted")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profile_sensitive")
}

// ---------- Organizations ----------

model Organization {
  id                 String                @id @default(uuid(7))
  type               OrganizationType
  name               String
  legalName          String?               @map("legal_name")
  countryCode        String                @map("country_code")
  educationSystem    String?               @map("education_system")
  website            String?
  industry           String?
  size               String?
  /// Credential issuing and verification responses gated on VERIFIED (RBAC.md).
  verificationStatus OrgVerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?             @map("verified_at")
  verifiedById       String?               @map("verified_by_id")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  deletedAt          DateTime?             @map("deleted_at")

  members              OrganizationMember[]
  relationships        OrganizationRelationship[]
  verificationRequests VerificationRequest[]
  issuedCredentials    Credential[]               @relation("CredentialIssuer")

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid(7))
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  role           OrganizationRole
  invitedById    String?          @map("invited_by_id")
  joinedAt       DateTime         @default(now()) @map("joined_at")
  removedAt      DateTime?        @map("removed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

/// The ONLY lens an organization has on a user (PRODUCT_REQUIREMENTS §7.3).
model OrganizationRelationship {
  id             String                @id @default(uuid(7))
  organizationId String                @map("organization_id")
  userId         String                @map("user_id")
  type           RelationshipType
  status         RelationshipStatus    @default(INVITED)
  initiatedBy    RelationshipInitiator @map("initiated_by")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, type])
  @@map("organization_relationships")
}

// ---------- Career data ----------

model Education {
  id              String    @id @default(uuid(7))
  userId          String    @map("user_id")
  institutionName String    @map("institution_name")
  /// Set when the institution is on the platform.
  organizationId  String?   @map("organization_id")
  degreeType      String    @map("degree_type")
  fieldOfStudy    String?   @map("field_of_study")
  countryCode     String    @map("country_code")
  educationSystem String?   @map("education_system")
  startDate       DateTime  @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  grade           String?
  description     String?
  displayOrder    Int       @default(0) @map("display_order")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, displayOrder])
  @@map("educations")
}

model Experience {
  id             String         @id @default(uuid(7))
  userId         String         @map("user_id")
  companyName    String         @map("company_name")
  organizationId String?        @map("organization_id")
  position       String
  employmentType EmploymentType @map("employment_type")
  location       String?
  countryCode    String?        @map("country_code")
  startDate      DateTime       @map("start_date") @db.Date
  endDate        DateTime?      @map("end_date") @db.Date
  description    String?
  displayOrder   Int            @default(0) @map("display_order")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, displayOrder])
  @@map("experiences")
}

model Skill {
  id           String        @id @default(uuid(7))
  userId       String        @map("user_id")
  name         String
  category     SkillCategory
  level        String?
  displayOrder Int           @default(0) @map("display_order")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, displayOrder])
  @@map("skills")
}

model UserLanguage {
  id           String            @id @default(uuid(7))
  userId       String            @map("user_id")
  /// ISO 639-1.
  language     String
  level        LanguageLevel
  framework    LanguageFramework @default(CEFR)
  source       LanguageSource    @default(SELF_DECLARED)
  /// FK to credentials lands in Phase 2; CERTIFIED requires it then.
  credentialId String?           @map("credential_id")
  displayOrder Int               @default(0) @map("display_order")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  deletedAt    DateTime?         @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, displayOrder])
  @@map("user_languages")
}

// ---------- Verification (PRODUCT_REQUIREMENTS §5) ----------

model VerificationRequest {
  id             String                  @id @default(uuid(7))
  userId         String                  @map("user_id")
  subjectType    VerificationSubjectType @map("subject_type")
  subjectId      String                  @map("subject_id")
  organizationId String                  @map("organization_id")
  status         VerificationStatus      @default(PENDING)
  /// Canonical snapshot of the verifiable fields at request time. Confirmation
  /// is atomic over exactly this snapshot; the verifier sees nothing else.
  fieldSnapshot  Json                    @map("field_snapshot")
  /// SHA-256 over the canonical snapshot. Any write to a covered field on the
  /// subject entry reverts status to NONE in the same transaction.
  fieldHash      String                  @map("field_hash")
  requestedAt    DateTime                @default(now()) @map("requested_at")
  respondedAt    DateTime?               @map("responded_at")
  respondedById  String?                 @map("responded_by_id")
  expiresAt      DateTime                @map("expires_at")
  revokedAt      DateTime?               @map("revoked_at")
  revokeReason   String?                 @map("revoke_reason")

  user         User         @relation("VerificationSubjectUser", fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([subjectType, subjectId])
  @@index([organizationId, status])
  @@map("verification_requests")
}

/// Single-use tokens for email verification and password reset.
/// Only the SHA-256 hash is stored; the raw token goes into the email link.
model ActionToken {
  id        String          @id @default(uuid(7))
  userId    String          @map("user_id")
  type      ActionTokenType
  tokenHash String          @unique @map("token_hash")
  expiresAt DateTime        @map("expires_at")
  usedAt    DateTime?       @map("used_at")
  createdAt DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("action_tokens")
}

/// A CV references Career ID records; it never copies them. Presentation
/// tweaks live in cv_items.displayOverride (§22) — the source stays intact.
model Cv {
  id                String    @id @default(uuid(7))
  userId            String    @map("user_id")
  title             String
  templateKey       String    @map("template_key")
  language          String
  targetCountryCode String?   @map("target_country_code")
  /// Per-CV decision (§20), never per-user.
  photoEnabled      Boolean   @default(false) @map("photo_enabled")
  /// Ordered array of section types; hidden sections keep their slot.
  sectionOrder      Json      @map("section_order")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CvItem[]

  @@index([userId])
  @@map("cvs")
}

model CvItem {
  id         String           @id @default(uuid(7))
  cvId       String           @map("cv_id")
  sourceType CvItemSourceType @map("source_type")
  /// Career ID record reference; null only for CUSTOM items.
  sourceId   String?          @map("source_id")
  /// Presentation-only JSON — NEVER written back to the source. Locked keys
  /// of VERIFIED sources are rejected server-side (§22, §65 test 14).
  displayOverride Json?       @map("display_override")
  order      Int
  visible    Boolean          @default(true)

  cv Cv @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@index([cvId, order])
  @@map("cv_items")
}

/// Every render creates a NEW immutable version (§26) — a CV already sent to
/// an employer must stay reconstructable. A generated file is never a
/// credential; badges live on entries, not on the document (§26).
model DocumentVersion {
  id          String           @id @default(uuid(7))
  sourceType  RenderSourceType @map("source_type")
  sourceId    String           @map("source_id")
  documentId  String           @map("document_id")
  templateKey String           @map("template_key")
  language    String
  renderedAt  DateTime         @default(now()) @map("rendered_at")

  @@index([sourceType, sourceId, renderedAt])
  @@map("document_versions")
}

/// Async render bookkeeping — ownership-checked job status for polling.
model RenderJob {
  id         String           @id @default(uuid(7))
  userId     String           @map("user_id")
  sourceType RenderSourceType @map("source_type")
  sourceId   String           @map("source_id")
  status     RenderJobStatus  @default(QUEUED)
  documentId String?          @map("document_id")
  error      String?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("render_jobs")
}

/// An application is a composed package of Career ID artifacts (§7.10). The
/// pasted job description may contain third-party data — it lives only as
/// long as the application and is nulled on delete (P4).
model Application {
  id             String            @id @default(uuid(7))
  userId         String            @map("user_id")
  title          String
  type           ApplicationType
  recipientName  String?           @map("recipient_name")
  jobDescription String?           @map("job_description")
  status         ApplicationStatus @default(DRAFT)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ApplicationItem[]

  @@index([userId])
  @@map("applications")
}

model ApplicationItem {
  id            String              @id @default(uuid(7))
  applicationId String              @map("application_id")
  itemType      ApplicationItemType @map("item_type")
  /// Referenced artifact id; for SECTION items the section key instead.
  itemId        String              @map("item_id")
  order         Int

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, order])
  @@map("application_items")
}

/// Secure share link (§35): the token (≥128-bit CSPRNG) is stored hashed;
/// revocation is server-side and immediate. Verification badges are NEVER
/// frozen — the viewer resolves them live at view time (§34).
model SharePackage {
  id              String    @id @default(uuid(7))
  userId          String    @map("user_id")
  applicationId   String    @map("application_id")
  tokenHash       String    @unique @map("token_hash")
  downloadAllowed Boolean   @default(true) @map("download_allowed")
  viewLimit       Int?      @map("view_limit")
  viewCount       Int       @default(0) @map("view_count")
  pinHash         String?   @map("pin_hash")
  expiresAt       DateTime? @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessLogs ShareAccessLog[]

  @@index([userId])
  @@map("share_packages")
}

/// Coarse by design (§36): when, org hint, sections — no fingerprinting.
model ShareAccessLog {
  id             String   @id @default(uuid(7))
  sharePackageId String   @map("share_package_id")
  accessedAt     DateTime @default(now()) @map("accessed_at")
  sectionsViewed Json?    @map("sections_viewed")
  orgHint        String?  @map("org_hint")
  ipCoarse       String?  @map("ip_coarse")

  sharePackage SharePackage @relation(fields: [sharePackageId], references: [id], onDelete: Cascade)

  @@index([sharePackageId, accessedAt])
  @@map("share_access_logs")
}

/// Real consent objects (§38), individually revocable; revoking the consent
/// kills the share it authorizes.
model Consent {
  id            String    @id @default(uuid(7))
  subjectUserId String    @map("subject_user_id")
  recipient     String
  purpose       String
  resources     Json
  grantedAt     DateTime  @default(now()) @map("granted_at")
  expiresAt     DateTime? @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")

  subject User @relation(fields: [subjectUserId], references: [id], onDelete: Cascade)

  @@index([subjectUserId])
  @@map("consents")
}

/// Cover letters vary by country convention, not by design (§23): the layout
/// axis reuses the CV template look; the convention axis (DE/FR/EN/AR)
/// controls the letter's structural norm.
model CoverLetter {
  id             String                @id @default(uuid(7))
  userId         String                @map("user_id")
  title          String
  /// FK to applications lands with milestone 3.6.
  applicationId  String?               @map("application_id")
  layoutTemplate String                @map("layout_template")
  convention     CoverLetterConvention
  /// The letter's language (ISO 639-1) — may exceed platform locales, e.g. "de".
  language       String
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  deletedAt      DateTime?             @map("deleted_at")

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  blocks CoverLetterBlock[]

  @@index([userId])
  @@map("cover_letters")
}

/// Block granularity (§24) so single paragraphs can be regenerated, and
/// origin tracking (§28): AI output never lands in content directly —
/// draft_content is the staging field, promotion is an explicit user act.
model CoverLetterBlock {
  id            String               @id @default(uuid(7))
  coverLetterId String               @map("cover_letter_id")
  type          CoverLetterBlockType
  order         Int
  content       String               @default("")
  draftContent  String?              @map("draft_content")
  origin        BlockOrigin          @default(USER)
  updatedAt     DateTime             @updatedAt @map("updated_at")

  coverLetter CoverLetter @relation(fields: [coverLetterId], references: [id], onDelete: Cascade)

  @@index([coverLetterId, order])
  @@map("cover_letter_blocks")
}

/// Issued credentials are NEVER deleted (§6) — no deletedAt, FK Restrict.
/// A user's account erasure anonymizes subject linkage instead of deleting
/// issuer records. Every status change appends to CredentialStatusHistory.
model Credential {
  id                   String           @id @default(uuid(7))
  issuerOrganizationId String           @map("issuer_organization_id")
  subjectUserId        String           @map("subject_user_id")
  credentialType       CredentialType   @map("credential_type")
  /// Structured claim data; schemas per type live in @careerid/shared.
  payload              Json
  countryCode          String?          @map("country_code")
  educationSystem      String?          @map("education_system")
  credentialFramework  String?          @map("credential_framework")
  language             String?
  issuedAt             DateTime         @map("issued_at")
  expiresAt            DateTime?        @map("expires_at")
  status               CredentialStatus @default(OFFERED)
  supersededById       String?          @unique @map("superseded_by_id")
  verificationMethod   String           @default("ISSUER_VERIFIED") @map("verification_method")
  evidence             Json?
  documentId           String?          @map("document_id")
  /// { alg: "Ed25519", keyId, signature } over the canonical signing document.
  signature            Json
  acceptedAt           DateTime?        @map("accepted_at")
  idempotencyKey       String?          @map("idempotency_key")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  issuer        Organization              @relation("CredentialIssuer", fields: [issuerOrganizationId], references: [id], onDelete: Restrict)
  subject       User                      @relation("CredentialSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  supersededBy  Credential?               @relation("CredentialSupersession", fields: [supersededById], references: [id])
  supersedes    Credential?               @relation("CredentialSupersession")
  statusHistory CredentialStatusHistory[]

  @@unique([issuerOrganizationId, idempotencyKey])
  @@index([subjectUserId, status])
  @@index([issuerOrganizationId])
  @@map("credentials")
}

/// Append-only transition log; written in the same transaction as the change.
model CredentialStatusHistory {
  id           String            @id @default(uuid(7))
  credentialId String            @map("credential_id")
  fromStatus   CredentialStatus? @map("from_status")
  toStatus     CredentialStatus  @map("to_status")
  actorUserId  String?           @map("actor_user_id")
  reason       String?
  createdAt    DateTime          @default(now()) @map("created_at")

  credential Credential @relation(fields: [credentialId], references: [id], onDelete: Restrict)

  @@index([credentialId, createdAt])
  @@map("credential_status_history")
}

/// Wallet file metadata — the bytes live in object storage, never in the DB
/// (DATABASE_SCHEMA §5). mimeType is the SNIFFED type; extensions are never
/// trusted. Downloads are gated on scanStatus = CLEAN, fail-closed.
model Document {
  id               String           @id @default(uuid(7))
  ownerUserId      String           @map("owner_user_id")
  category         DocumentCategory
  origin           DocumentOrigin
  fileName         String           @map("file_name")
  mimeType         String?          @map("mime_type")
  sizeBytes        Int?             @map("size_bytes")
  storageKey       String           @map("storage_key")
  checksumSha256   String?          @map("checksum_sha256")
  scanStatus       ScanStatus       @default(PENDING) @map("scan_status")
  encryptionKeyRef String?          @map("encryption_key_ref")
  language         String?
  versionOfId      String?          @map("version_of_id")
  versionNumber    Int              @default(1) @map("version_number")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  owner     User       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  versionOf Document?  @relation("DocumentVersions", fields: [versionOfId], references: [id])
  versions  Document[] @relation("DocumentVersions")

  @@index([ownerUserId, category])
  @@map("documents")
}

/// CSRF/replay protection for the OIDC authorization-code flow. State is a
/// random token (hash stored), bound to provider + purpose; LINK states carry
/// the authenticated user they may attach an identity to.
model OauthState {
  id        String           @id @default(uuid(7))
  stateHash String           @unique @map("state_hash")
  provider  IdentityProvider
  purpose   OauthPurpose
  userId    String?          @map("user_id")
  expiresAt DateTime         @map("expires_at")
  usedAt    DateTime?        @map("used_at")
  createdAt DateTime         @default(now()) @map("created_at")

  @@map("oauth_states")
}

// ---------- Notifications & audit ----------

model Notification {
  id        String    @id @default(uuid(7))
  userId    String    @map("user_id")
  type      String
  payload   Json
  channels  String[]
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

/// Append-only, hash-chained (SECURITY.md §1). The application role receives
/// INSERT+SELECT only — grant applied in migration SQL, chain verified by a job.
model AuditEvent {
  id        String         @id @default(uuid(7))
  sequence  BigInt         @unique @default(autoincrement())
  actorType AuditActorType @map("actor_type")
  actorId   String?        @map("actor_id")
  action    String
  targetType String?       @map("target_type")
  targetId  String?        @map("target_id")
  /// IDs and coarse facts only — no PII payloads in audit metadata.
  metadata  Json?
  ipCoarse  String?        @map("ip_coarse")
  prevHash  String         @map("prev_hash")
  hash      String
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([actorType, actorId])
  @@map("audit_events")
}
