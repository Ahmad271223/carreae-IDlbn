# Copy to .env for local development. NEVER commit real values.

# --- Database ---
DATABASE_URL=postgresql://careerid:careerid_dev@localhost:5432/careerid

# --- Redis (cache + queues) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO in dev) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=careerid-dev
S3_SECRET_KEY=careerid-dev-secret
S3_BUCKET_QUARANTINE=careerid-quarantine
S3_BUCKET_DOCUMENTS=careerid-documents

# --- Auth ---
SESSION_SECRET=change-me-dev-only
ARGON2_MEMORY_KIB=65536
# Requests per minute; login endpoint uses the stricter AUTH limit.
THROTTLE_DEFAULT_LIMIT=100
AUTH_THROTTLE_LIMIT=10

# --- Mail (Mailpit in dev) ---
SMTP_URL=smtp://localhost:1025
MAIL_FROM=noreply@localhost

# --- Malware scanning ---
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- AI provider (optional in dev; features degrade gracefully) ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- App ---
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
NODE_ENV=development
